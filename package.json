{
  "name": "furtu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FURTU — fast, private, simple, powerful. A local-first digital utility platform.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:seo": "node scripts/audit-seo.mjs",
    "prerender": "node scripts/prerender.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "audit:browser": "node scripts/browser-audit.mjs",
    "test:tools": "node scripts/test-all-tools.mjs",
    "test:ads": "node scripts/check-ads.mjs",
    "report:bundle": "node scripts/report-bundle.mjs",
    "assets:fonts": "node scripts/fetch-fonts.mjs",
    "assets:og": "node scripts/make-og-image.mjs",
    "assets": "npm run assets:fonts && npm run build && npm run assets:og",
    "verify": "npm run typecheck && npm run test && npm run build && npm run audit:seo",
    "verify:browser": "node scripts/browser-audit.mjs && node scripts/test-all-tools.mjs && node scripts/check-ads.mjs",
    "format": "oxfmt src scripts tests"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^2.1.8"
  }
}
